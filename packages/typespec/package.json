{
  "name": "@adofai-ipc/typespec",
  "version": "2.1.0",
  "type": "module",
  "license": "MIT",
  "description": "TypeSpec contracts and TypeScript/C# code generation for ADOFAI IPC.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KGH1113/adofai-ipc.git",
    "directory": "packages/typespec"
  },
  "homepage": "https://adofai-ipc.impl1113.dev/docs/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "tspMain": "./lib/main.tsp",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "typespec": "./lib/main.tsp",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "adofai-ipc": "./bin/adofai-ipc.mjs"
  },
  "files": [
    "dist",
    "lib",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test tests/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@typespec/compiler": "1.17.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "adofai-ipc": "workspace:^",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts"
}
