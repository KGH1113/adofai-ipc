{
  "name": "adofai-ipc",
  "version": "2.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KGH1113/adofai-ipc.git",
    "directory": "packages/adofai-ipc"
  },
  "homepage": "https://github.com/KGH1113/adofai-ipc#readme",
  "bugs": {
    "url": "https://github.com/KGH1113/adofai-ipc/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js",
      "require": "./dist/transport.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/transport.ts --format esm,cjs --splitting --dts --clean",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test tests/**/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "description": "Typed bidirectional IPC for ADOFAI mods and external apps."
}
