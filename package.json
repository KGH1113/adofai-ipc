{
  "name": "adofai-ipc-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "node scripts/tasks/validate/architecture.mjs && pnpm -r check",
    "clean": "pnpm -r clean",
    "docs:dev": "pnpm --filter @adofai-ipc/docs dev",
    "docs:build": "pnpm --filter @adofai-ipc/docs build",
    "docs:check": "pnpm --filter @adofai-ipc/docs check",
    "docs:preview": "pnpm --filter @adofai-ipc/docs preview",
    "ipc:generate": "pnpm --filter @adofai-ipc/typespec build && adofai-ipc generate --config packages/typespec/tests/fixtures/typed/adofai-ipc.config.json",
    "check:architecture": "node scripts/tasks/validate/architecture.mjs"
  },
  "devDependencies": {
    "@adofai-ipc/typespec": "workspace:^",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.7.0"
}
